{
  "_contract": "BR6 — Stockout Risk",
  "_endpoint": "GET /api/br6/stockout",
  "_warehouse": "Postgres",
  "_table": "fact_inventory_daily",
  "_source": "fact_inventory_daily",
  "_columns_required": ["days_to_stockout", "is_below_reorder"],
  "_primary_key": "((warehouse_id), days_to_stockout, product_id)",
  "_sentinel": "days_to_stockout=9999.0 when velocity_7d=0 (no movement in 7 days)",
  "_WARNING_1": "stock_on_hand is SEMI-ADDITIVE: NEVER sum across multiple dates. SUM across warehouse_id on ONE date = valid total stock for that day.",
  "_WARNING_2": "This endpoint MUST filter on exactly ONE inventory_date. Never leave the date filter open — summing stock across multiple dates double-counts.",
  "_WARNING_3": "SUM(stock_on_hand) across warehouses on the same date is valid and represents total network stock for that SKU on that day.",
