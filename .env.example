# ShopInsight - the values docker-compose.yml and the Python scripts share.
#
# You do not have to do anything with this file. docker-compose.yml falls back to exactly
# these values, and serving/check_infra.py reads this file when there is no .env. Copy it
# only when you need to change one of them:
#
#     cp .env.example .env
#
# .env is gitignored and this file is not (.gitignore already negates .env.example), so
# the defaults travel and your local change does not. Change a value here and in
# docker-compose.yml's ${...:-default} in the same commit, or the two disagree.
#
# One KEY=value per line. No quotes, and no comment after a value on the same line: both
# docker compose and read_env() would keep it as part of the value.
#
# THIS PASSWORD IS NOT A SECRET. It protects a container on your own laptop and nothing
# else. Nothing in these two stores is irreplaceable - the star schema is rebuilt by
# processing/batch_warehouse.py and the Cassandra tables by serving/apply_schema.py.

# Cassandra. CASSANDRA_PORT is the port compose publishes AND the port Python connects
# to. CASSANDRA_HOST and CASSANDRA_KEYSPACE are read by Python only. The keyspace does
# not exist yet: serving/apply_schema.py creates it, and check_infra.py deliberately
# does not need it.
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=shopinsight

# Postgres. POSTGRES_DB, POSTGRES_USER and POSTGRES_PASSWORD are used twice: the
# container creates the database with them on its FIRST start, and Python connects with
# them. POSTGRES_HOST is read by Python only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=shopinsight
POSTGRES_USER=shopinsight
POSTGRES_PASSWORD=local_dev_only
