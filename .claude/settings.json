{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python ingestion/*)",
      "Bash(python processing/*)",
      "Bash(python serving/*)",
      "Bash(python benchmark/*)",
      "Bash(python3 ingestion/*)",
      "Bash(python3 processing/*)",
      "Bash(python3 serving/*)",
      "Bash(python3 benchmark/*)",
      "Bash(pytest *)",
      "Bash(uvicorn *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose logs *)",
      "Bash(docker ps *)",
      "Bash(psql *)",
      "Bash(cqlsh *)",
      "Bash(duckdb *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(grep *)",
      "Bash(jq *)",
      "Bash(column *)"
    ],
    "deny": [
      "Write(data/**)",
      "Edit(data/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data.py",
            "timeout": 5,
            "statusMessage": "Checking the command against data/ and git rules"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check_python.py",
            "timeout": 10,
            "statusMessage": "Compiling the file and checking the project traps"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session_status.py",
            "timeout": 5,
            "statusMessage": "Reading repo status"
          }
        ]
      }
    ]
  }
}
